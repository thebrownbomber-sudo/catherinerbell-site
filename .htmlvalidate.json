{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "no-trailing-whitespace": "off",
    "void-style": "off",
    "attribute-boolean-style": "off",
    "attribute-empty-style": "off",
    "long-title": "off",
    "no-redundant-for": "off",
    "prefer-native-element": "off",
    "script-type": "off",
    "unique-landmark": "off",
    "doctype-style": "off",
    "attr-case": "off",
    "element-case": "off"
  }
}
